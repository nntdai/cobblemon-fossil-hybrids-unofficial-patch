{
 "head": "head",
 "portraitScale": 0.6,
 "portraitTranslation": [ -1, 2, 0 ],
 "profileScale": 0.3,
 "profileTranslation": [ 0, 1.2, 0 ],

 "poses": {
  "standing": {
    "poseTypes": ["STAND", "NONE", "PORTRAIT", "PROFILE"],
          "condition": "!q.in_air",
    "isBattle": false,
    "animations": ["look",
      "q.bedrock('archerantrum', 'ground_idle')"
    ],
    "quirks": [
      "q.bedrock_quirk('archerantrum', 'blink')"
    ]
  },
 "battle-standing": {
      "poseTypes": ["STAND"],
      "isBattle": true,
      "animations": [
        "q.look('head')",
        "q.bedrock('archerantrum', 'battle_idle')"
      ],
      "quirks": ["q.bedrock_quirk('archerantrum', 'blink')"]
    },

    "jump": {
      "poseTypes": ["STAND", "WALK"],
      "condition": "q.in_air",
      "animations": [
        "q.look('head')",
        "q.bedrock('archerantrum', 'ride_jump')"
      ],
      "quirks": [
        "q.bedrock_quirk('archerantrum', 'blink')"
      ],
      "transformTicks": 3,
      "transformToTicks": 3
    },
    
  "walking": {
    "poseTypes": ["WALK"],
      "condition": "!q.in_air && !q.is_sprinting",
    "animations": ["look",
      "q.bedrock('archerantrum', 'ground_walk')"
    ],
    "quirks": ["q.bedrock_quirk('archerantrum', 'blink')"]
  },

      "running": {
      "poseTypes": ["WALK"],
      "isBattle": false,
      "condition": "!q.in_air && q.is_sprinting",
      "animations": [
        "q.look('head')",
        "q.bedrock('archerantrum', 'ground_run')"
      ],
      "quirks": ["q.bedrock_quirk('archerantrum', 'blink')"]
    },

  "float": {
    "poseTypes": ["FLOAT"],
    "animations": [
      "q.bedrock('archerantrum', 'ground_idle')"
    ],
    "quirks": ["q.bedrock_quirk('archerantrum', 'blink')"]
  },
  "swim": {
    "poseTypes": ["SWIM"],
    "animations": [
      "q.bedrock('archerantrum', 'ground_walk')"
    ],
    "quirks": ["q.bedrock_quirk('archerantrum', 'blink')"]
  },
  "sleep": {
    "poseTypes": ["SLEEP"],
    "animations": ["q.bedrock('archerantrum', 'sleep')"]
  }
 }
}